# Obtain these from your Supabase project. Never use a service-role key in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local-only simulated channels are configured by later adapters; no Meta credentials assumed.

# Meta server-only; unavailable values keep real integrations disconnected.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_CREDENTIAL_ENCRYPTION_KEY=
META_GRAPH_VERSION=
WHATSAPP_WORKER_SECRET=

# Official Instagram Login API; server-only. Leave empty for explicit simulated mode.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_STATE_SECRET=
INSTAGRAM_ENCRYPTION_KEY=
INSTAGRAM_VERIFY_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
INSTAGRAM_WORKER_SECRET=
